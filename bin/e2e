        log "Installing npm dependencies..."
        (cd "${RUN_DIR}" && npm install --silent 2>&1 | /usr/bin/tail -5)
        (
            cd "${RUN_DIR}"
            git init -q
            printf "node_modules/\ndist/\n.env\n" > .gitignore
            git add -A
            git -c user.email="e2e@loopr" -c user.name="e2e" commit -q -m "init"
