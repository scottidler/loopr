#!/usr/bin/env bash
set -euo pipefail

# bin/e2e - End-to-end runner for loopr-v5
#
# Modeled on v3's bin/test-run.sh: one self-contained script that scaffolds a
# fresh target into /tmp, starts the daemon, submits a Plan, monitors progress,
# verifies the outcome, and snapshots results.
#
# Usage:
#   bin/e2e                           # default target: rust-version
#   bin/e2e ls                        # list available targets
#   bin/e2e rust-version              # run a specific target
#   bin/e2e rust-version --timeout 1200
#   bin/e2e --no-build rust-version   # skip cargo install --path crates/loopr
#   bin/e2e --build rust-version      # force re-install of the loopr binary
#
# The installed binary at ~/.cargo/bin/loopr is exercised throughout. Use
# --build to refresh it from this workspace before the run.

LOOPR_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOOPR_BIN="${HOME}/.cargo/bin/loopr"
DAEMON_PID=""
# E2E always runs at DEBUG so events.log carries every span (lifeguard,
# tools, decomposer, integrator). Override with --log-level if needed.
LOG_LEVEL="debug"

###############################################################################
# Colors
###############################################################################

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

log()  { echo -e "${CYAN}[e2e]${NC} $*"; }
ok()   { echo -e "${GREEN}[e2e]${NC} $*"; }
warn() { echo -e "${YELLOW}[e2e]${NC} $*"; }
err()  { echo -e "${RED}[e2e]${NC} $*" >&2; }

###############################################################################
# Usage
###############################################################################

usage() {
    echo -e "${BOLD}Usage:${NC} bin/e2e [options] [target]"
    echo ""
    echo -e "${BOLD}Options:${NC}"
    echo "  ls, --list          List available targets"
    echo "  --target <name>     Target to run (default: rust-version)"
    echo "  --timeout <secs>    Override the target's default timeout"
    echo "  --build             cargo install --path crates/loopr --force before running"
    echo "  --no-build          Use whatever binary is at ~/.cargo/bin/loopr (default)"
    echo "  --skip-eval         Skip the optional Claude evaluation step"
    echo "  --log-level <lvl>   Override log level (default: debug). Use 'info' for terse output."
    echo "  --validation-command <cmd>  integrator.validation-commands entry (repeatable; default: per-target)"
    echo "  -h, --help          Show this help"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  bin/e2e"
    echo "  bin/e2e ls"
    echo "  bin/e2e rust-version"
    echo "  bin/e2e --build rust-version --timeout 1200"
}

list_targets() {
    echo -e "${BOLD}${CYAN}Available E2E targets:${NC}"
    echo ""
    local default="rust-version"
    for f in "${LOOPR_ROOT}"/bin/e2e-targets/*.md; do
        local name marker
        name="$(basename "${f}" .md)"
        marker=""
        if [[ "${name}" == "${default}" ]]; then
            marker=" ${YELLOW}(default)${NC}"
        fi
        printf "  ${CYAN}%-22s${NC}%b\n" "${name}" "${marker}"
    done
    echo ""
    echo -e "Run with: ${BOLD}bin/e2e <target>${NC}"
}

###############################################################################
# Args
###############################################################################

E2E_TARGET=""
E2E_TIMEOUT=""
DO_BUILD=false
SKIP_EVAL=false
SUBCOMMAND=""
VALIDATION_COMMANDS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        ls|--list)   SUBCOMMAND="ls"; shift ;;
        -h|--help)   usage; exit 0 ;;
        --target)    E2E_TARGET="$2"; shift 2 ;;
        --timeout)   E2E_TIMEOUT="$2"; shift 2 ;;
        --build)     DO_BUILD=true; shift ;;
        --no-build)  DO_BUILD=false; shift ;;
        --skip-eval) SKIP_EVAL=true; shift ;;
        --log-level) LOG_LEVEL="$2"; shift 2 ;;
        --validation-command) VALIDATION_COMMANDS+=("$2"); shift 2 ;;
        -*)          err "Unknown flag: $1"; usage; exit 1 ;;
        *)           E2E_TARGET="$1"; shift ;;
    esac
done

if [[ "${SUBCOMMAND}" == "ls" ]]; then
    list_targets
    exit 0
fi

E2E_TARGET="${E2E_TARGET:-rust-version}"
case "${E2E_TARGET}" in
    python-api|python-scraper|rust-cli|node-api|react-todo)
        TIMEOUT="${E2E_TIMEOUT:-1200}" ;;
    *)
        TIMEOUT="${E2E_TIMEOUT:-900}" ;;
esac

PLAN_MD="${LOOPR_ROOT}/bin/e2e-targets/${E2E_TARGET}.md"
if [[ ! -f "${PLAN_MD}" ]]; then
    err "Unknown target: ${E2E_TARGET}"
    err "No plan markdown at ${PLAN_MD}"
    err ""
    err "Run 'bin/e2e ls' to see available targets."
    exit 1
fi

# Phase 12 (2026-07-11 verified-swarm) made integrator.require-validation
# default true, so a target with no validation-commands refuses to start.
# Give each target family a sensible default check; override it -- or set the
# red-path check (e.g. --validation-command false) -- with --validation-command.
if [[ ${#VALIDATION_COMMANDS[@]} -eq 0 ]]; then
    case "${E2E_TARGET}" in
        rust-version|rust-cli)                  VALIDATION_COMMANDS=("cargo test") ;;
        node-api|react-todo)                    VALIDATION_COMMANDS=("npm test") ;;
        python-api|python-scraper|python-todo)  VALIDATION_COMMANDS=("pytest -q") ;;
        *)                                       VALIDATION_COMMANDS=("cargo test") ;;
    esac
fi

###############################################################################
# Pre-flight
###############################################################################

if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    err "ANTHROPIC_API_KEY is not set"
    exit 1
fi

if [[ "${DO_BUILD}" == "true" ]]; then
    log "Re-installing loopr from ${LOOPR_ROOT}/crates/loopr ..."
    (cd "${LOOPR_ROOT}" && cargo install --path crates/loopr --force 2>&1 | /usr/bin/tail -3)
fi

if [[ ! -x "${LOOPR_BIN}" ]]; then
    err "loopr binary not found at ${LOOPR_BIN}"
    err "Run: bin/e2e --build, or 'cargo install --path crates/loopr' from ${LOOPR_ROOT}"
    exit 1
fi
ok "Binary: ${LOOPR_BIN} ($("${LOOPR_BIN}" --version 2>/dev/null || echo unknown))"

###############################################################################
# Run dirs
###############################################################################

TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
TARGET_BASE="/tmp/loopr/e2e/${E2E_TARGET}"
RUN_DIR="${TARGET_BASE}/${TIMESTAMP}"
LATEST_LINK="${TARGET_BASE}/latest"
MONITOR_DIR="${RUN_DIR}/.monitor"

###############################################################################
# Cleanup
###############################################################################

BG_TAIL_PID=""
BG_MONITOR_PID=""

cleanup() {
    log "Cleaning up..."

    for pid in "${BG_TAIL_PID}" "${BG_MONITOR_PID}"; do
        [[ -n "${pid}" ]] && kill "${pid}" 2>/dev/null || true
    done

    if [[ -d "${RUN_DIR}/.loopr" ]]; then
        log "Stopping daemon..."
        "${LOOPR_BIN}" -C "${RUN_DIR}" daemon stop 2>/dev/null || true
        "${LOOPR_BIN}" -C "${RUN_DIR}" sessions end 2>/dev/null || true
    fi

    if [[ -n "${DAEMON_PID}" ]] && kill -0 "${DAEMON_PID}" 2>/dev/null; then
        kill "${DAEMON_PID}" 2>/dev/null || true
    fi

    wait 2>/dev/null || true
    log "Run dir: ${RUN_DIR}"
    log "Latest:  ${LATEST_LINK}"
}
trap cleanup EXIT

###############################################################################
# Reap any prior run for this target
###############################################################################

if [[ -L "${LATEST_LINK}" ]]; then
    PREV_DIR="$(readlink -f "${LATEST_LINK}")"
    if [[ -d "${PREV_DIR}" && "${PREV_DIR}" == /tmp/loopr/e2e/* ]]; then
        log "Reaping previous run: ${PREV_DIR}"
        if [[ -d "${PREV_DIR}/.loopr" ]]; then
            "${LOOPR_BIN}" -C "${PREV_DIR}" daemon stop 2>/dev/null || true
        fi
        # Sockets cannot be archived by rkvr; remove the dir directly. The
        # parent /tmp/loopr/ is a scratch tree (not user data).
        find "${PREV_DIR}" -type s -delete 2>/dev/null || true
        rm -rf "${PREV_DIR}"
    fi
    rm -f "${LATEST_LINK}"
fi

mkdir -p "${TARGET_BASE}"
ln -sfn "${RUN_DIR}" "${LATEST_LINK}"
ok "Run dir:    ${RUN_DIR} (will be created by scaffold)"
ok "Latest:     ${LATEST_LINK}"

###############################################################################
# Scaffold the target
###############################################################################

log "Scaffolding ${E2E_TARGET} at ${RUN_DIR} ..."
case "${E2E_TARGET}" in
    rust-version)
        # cargo init refuses non-empty dirs; let it create RUN_DIR fresh.
        cargo init --quiet --name e2e-target "${RUN_DIR}"
        (
            cd "${RUN_DIR}"
            git add -A
            git -c user.email="e2e@loopr" -c user.name="e2e" commit -q -m "init"
        )
        ok "Scaffold: $(wc -l < "${RUN_DIR}/src/main.rs") lines in src/main.rs"
        ;;

    python-todo)
        mkdir -p "${RUN_DIR}"
        if ! command -v python3 &>/dev/null; then err "python3 is not installed"; exit 1; fi
        if ! command -v uv &>/dev/null; then err "uv is not installed"; exit 1; fi
        cat > "${RUN_DIR}/pyproject.toml" <<'PYPROJECT'
[project]
name = "todo-app"
requires-python = ">=3.10"
dependencies = ["pytest"]

[tool.pytest.ini_options]
testpaths = ["."]
PYPROJECT
        cat > "${RUN_DIR}/README.md" <<'README'
# Todo App

A command-line todo application in Python.

## Requirements

- Add a todo item with a title
- List all todo items (with optional filter: all, active, done)
- Mark a todo item as done by ID
- Delete a todo item by ID
- Persist todos to a JSON file (todos.json)
- Include tests using pytest

## Run

    uv run python cli.py add "Buy milk"
    uv run python cli.py list

## Test

    uv run pytest test_todo.py -v
README
        cat > "${RUN_DIR}/test_todo.py" <<'TEST'
def test_stub():
    pass
TEST
        (
            cd "${RUN_DIR}"
            uv sync --quiet
            printf ".venv/\ntodos.json\n__pycache__/\n.pytest_cache/\n*.pyc\n" > .gitignore
            git init -q
            git add -A
            git -c user.email="e2e@loopr" -c user.name="e2e" commit -q -m "init"
        )
        ok "Python todo target ready at ${RUN_DIR}"
        ;;

    python-api)
        mkdir -p "${RUN_DIR}"
        if ! command -v docker &>/dev/null; then err "docker is not installed"; exit 1; fi
        if ! docker compose version &>/dev/null 2>&1; then err "docker compose is not available"; exit 1; fi
        log "Found: $(docker compose version)"
        cat > "${RUN_DIR}/pyproject.toml" <<'PYPROJECT'
[project]
name = "bookmarks-api"
version = "0.1.0"
requires-python = ">=3.12"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.32",
    "httpx>=0.28",
    "pytest>=8.3",
]
PYPROJECT
        cat > "${RUN_DIR}/Dockerfile" <<'DOCKER'
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
WORKDIR /app
COPY pyproject.toml .
RUN uv sync
COPY . .
CMD ["uv", "run", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
DOCKER
        cat > "${RUN_DIR}/docker-compose.yml" <<'COMPOSE'
services:
  api:
    build: .
    ports:
      - "8081:8080"
    volumes:
      - ./data:/app/data
    environment:
      - DATABASE_PATH=/app/data/bookmarks.db

  test:
    build: .
    command: uv run pytest test_api.py -v
    environment:
      - DATABASE_PATH=/tmp/test_bookmarks.db
COMPOSE
        cat > "${RUN_DIR}/test_api.py" <<'TEST'
def test_stub():
    pass
TEST
        cat > "${RUN_DIR}/main.py" <<'MAIN'
from fastapi import FastAPI

app = FastAPI()

@app.get("/health")
def health():
    return {"status": "ok"}
MAIN
        cat > "${RUN_DIR}/README.md" <<'README'
# Bookmarks API

A REST API for managing bookmarks, built with FastAPI and SQLite.

## Endpoints

- GET    /health          - health check
- GET    /bookmarks       - list all bookmarks
- POST   /bookmarks       - create a bookmark
- GET    /bookmarks/{id}  - get a bookmark by ID
- PUT    /bookmarks/{id}  - update a bookmark
- DELETE /bookmarks/{id}  - delete a bookmark

## Run

    docker compose up api
    curl http://localhost:8081/health

## Test

    docker compose run --rm test
README
        mkdir -p "${RUN_DIR}/data"
        (
            cd "${RUN_DIR}"
            git init -q
            printf ".venv/\ndata/*.db\n__pycache__/\n.pytest_cache/\n*.pyc\n" > .gitignore
            git add -A
            git -c user.email="e2e@loopr" -c user.name="e2e" commit -q -m "init: FastAPI skeleton and Docker config"
        )
        ok "Python API target ready at ${RUN_DIR}"
        ;;

    python-scraper)
        mkdir -p "${RUN_DIR}"
        if ! command -v docker &>/dev/null; then err "docker is not installed"; exit 1; fi
        if ! docker compose version &>/dev/null 2>&1; then err "docker compose is not available"; exit 1; fi
        log "Found: $(docker compose version)"
        cat > "${RUN_DIR}/requirements.txt" <<'REQ'
beautifulsoup4>=4.12
pytest>=8.3
REQ
        cat > "${RUN_DIR}/Dockerfile" <<'DOCKER'
FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
CMD ["python", "main.py"]
DOCKER
        cat > "${RUN_DIR}/docker-compose.yml" <<'COMPOSE'
services:
  harvester:
    build: .
    volumes:
      - ./data:/app/data
      - ./report.md:/app/report.md
    environment:
      - INPUT_DIR=/app/input
      - DATABASE_PATH=/app/data/links.db
      - REPORT_PATH=/app/report.md

  test:
    build: .
    command: python -m pytest test_scraper.py -v
    environment:
      - INPUT_DIR=/app/input
      - DATABASE_PATH=/tmp/test_links.db
      - REPORT_PATH=/tmp/test_report.md
COMPOSE
        mkdir -p "${RUN_DIR}/input" "${RUN_DIR}/data"
        cat > "${RUN_DIR}/input/page-a.html" <<'HTML'
