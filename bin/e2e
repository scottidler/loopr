#!/usr/bin/env bash
set -euo pipefail

# bin/e2e - Parameterized E2E test runner for loopr
#
# Usage:
#   bin/e2e                           # default target: rust-version
#   bin/e2e ls                        # list available targets
#   bin/e2e python-api                # run target by positional name
#   bin/e2e --target python-api       # run target by flag
#   bin/e2e python-api --timeout 600  # override timeout
#   bin/e2e --no-build python-api     # skip cargo build (use existing binary)

LOOPR_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DAEMON_PID=""

###############################################################################
# Colors and logging (defined first so they're available during arg parsing)
###############################################################################

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

log()  { echo -e "${CYAN}[e2e]${NC} $*"; }
ok()   { echo -e "${GREEN}[e2e]${NC} $*"; }
warn() { echo -e "${YELLOW}[e2e]${NC} $*"; }
err()  { echo -e "${RED}[e2e]${NC} $*" >&2; }

###############################################################################
# Usage
###############################################################################

usage() {
    echo -e "${BOLD}Usage:${NC} bin/e2e [options] [target]"
    echo ""
    echo -e "${BOLD}Options:${NC}"
    echo "  ls, --list          List available targets and their goals"
    echo "  --target <name>     Target to run (default: rust-version)"
    echo "  --timeout <secs>    Override the target's default timeout"
    echo "  --no-build          Skip 'cargo build --release' (use existing binary)"
    echo "  -h, --help          Show this help"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  bin/e2e ls"
    echo "  bin/e2e rust-version"
    echo "  bin/e2e python-api --timeout 1800"
    echo "  bin/e2e --target node-api"
}

###############################################################################
# List targets
###############################################################################

list_targets() {
    echo -e "${BOLD}${CYAN}Available E2E targets:${NC}"
    echo ""
    local default="rust-version"
    for f in "${LOOPR_ROOT}"/bin/e2e-targets/*.sh; do
        local name timeout goal marker
        name="$(basename "${f}" .sh)"
        timeout="$(bash -c "source '${f}' 2>/dev/null; echo \${TARGET_TIMEOUT:-600}" 2>/dev/null || echo "600")"
        goal="$(bash -c "source '${f}' 2>/dev/null; target_goal" 2>/dev/null || echo "(no goal)")"
        if [[ ${#goal} -gt 72 ]]; then
            goal="${goal:0:69}..."
        fi
        marker=""
        if [[ "${name}" == "${default}" ]]; then
            marker=" ${YELLOW}(default)${NC}"
        fi
        printf "  ${CYAN}%-22s${NC} ${YELLOW}%4ss${NC}  %s%b\n" "${name}" "${timeout}" "${goal}" "${marker}"
    done
    echo ""
    echo -e "Run with: ${BOLD}bin/e2e <target>${NC}"
}

###############################################################################
# Arg parsing
###############################################################################

E2E_TARGET=""
E2E_TIMEOUT=""
NO_BUILD=false
SUBCOMMAND=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        ls|--list)   SUBCOMMAND="ls"; shift ;;
        -h|--help)   usage; exit 0 ;;
        --target)    E2E_TARGET="$2"; shift 2 ;;
        --timeout)   E2E_TIMEOUT="$2"; shift 2 ;;
        --no-build)  NO_BUILD=true; shift ;;
        -*)          err "Unknown flag: $1"; echo ""; usage; exit 1 ;;
        *)           E2E_TARGET="$1"; shift ;;
    esac
done

# Handle ls early - no further setup needed
if [[ "${SUBCOMMAND}" == "ls" ]]; then
    list_targets
    exit 0
fi

E2E_TARGET="${E2E_TARGET:-rust-version}"

###############################################################################
# Run setup
###############################################################################

# Each run gets a timestamped subdirectory under the target name
RUN_TS="$(date +%Y%m%d-%H%M%S)"
TARGET_BASE="/tmp/loopr-e2e/${E2E_TARGET}"
TARGET="${TARGET_BASE}/${RUN_TS}"
LATEST_LINK="${TARGET_BASE}/latest"

cleanup() {
    if [[ -n "${DAEMON_PID}" ]] && kill -0 "${DAEMON_PID}" 2>/dev/null; then
        log "Shutting down daemon (PID ${DAEMON_PID})..."
        kill "${DAEMON_PID}" 2>/dev/null || true
        wait "${DAEMON_PID}" 2>/dev/null || true
    fi
}
trap cleanup EXIT

###############################################################################
# Load target definition
###############################################################################

TARGET_FILE="${LOOPR_ROOT}/bin/e2e-targets/${E2E_TARGET}.sh"
if [[ ! -f "${TARGET_FILE}" ]]; then
    err "Unknown target: ${E2E_TARGET}"
    err ""
    err "Run 'bin/e2e ls' to see available targets."
    exit 1
fi

# shellcheck source=/dev/null
source "${TARGET_FILE}"
log "Target: ${E2E_TARGET}"

TIMEOUT="${E2E_TIMEOUT:-${TIMEOUT:-${TARGET_TIMEOUT:-600}}}"

###############################################################################
# Pre-flight
###############################################################################

if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
    err "ANTHROPIC_API_KEY is not set"
    exit 1
fi

###############################################################################
# Step 1: Build loopr
###############################################################################

LOOPR="${LOOPR_ROOT}/target/release/loopr"

if [[ "${NO_BUILD}" == "true" ]]; then
    if [[ ! -x "${LOOPR}" ]]; then
        err "--no-build specified but binary not found at ${LOOPR}"
        exit 1
    fi
    log "Skipping build (--no-build), using existing binary"
else
    log "Building loopr (release)..."
    (cd "${LOOPR_ROOT}" && cargo build --release 2>&1 | /usr/bin/tail -3)
    if [[ ! -x "${LOOPR}" ]]; then
        err "Build failed - binary not found at ${LOOPR}"
        exit 1
    fi
fi
ok "Binary: ${LOOPR}"

###############################################################################
# Step 2: Scaffold target (delegated to target definition)
###############################################################################

mkdir -p "${TARGET}"
ln -sfn "${TARGET}" "${LATEST_LINK}"

log "Run directory: ${TARGET}"
log "Latest link:   ${LATEST_LINK}"
log "Scaffolding target at ${TARGET}..."
scaffold

###############################################################################
# Step 3: Write config for the target
###############################################################################

CONFIG="${TARGET}/loopr.yml"
VALIDATION_CMDS="$(target_validation_commands)"
{
cat <<YAML
log_level: debug

project:
  repo_path: "${TARGET}"
  worktree_dir: .worktrees

agents:
  enabled: true
  auto_start_implementer: true
  auto_start_reviewer: true
  pull_based_workers: true
  coordinator:
    interview_mode: skip

integrator:
  enabled: true
  interval_secs: 15
YAML
if [[ -n "${VALIDATION_CMDS}" ]]; then
    echo "  validation_commands:"
    echo "${VALIDATION_CMDS}"
else
    echo "  validation_commands: []"
fi
cat <<YAML

validator:
  enabled: false
YAML
} > "${CONFIG}"
ok "Config written to ${CONFIG}"

###############################################################################
# Step 4: Kill any existing daemon
###############################################################################

PID_FILE="${HOME}/.local/share/loopr/daemon.pid"
if [[ -f "${PID_FILE}" ]]; then
    OLD_PID="$(cat "${PID_FILE}" 2>/dev/null || true)"
    if [[ -n "${OLD_PID}" ]] && kill -0 "${OLD_PID}" 2>/dev/null; then
        log "Killing existing daemon (PID ${OLD_PID})..."
        kill "${OLD_PID}" 2>/dev/null || true
        for _ in $(seq 1 30); do
            kill -0 "${OLD_PID}" 2>/dev/null || break
            sleep 0.5
        done
        if kill -0 "${OLD_PID}" 2>/dev/null; then
            warn "Daemon still alive after 15s, sending SIGKILL..."
            kill -9 "${OLD_PID}" 2>/dev/null || true
            sleep 1
        fi
    fi
    rm -f "${PID_FILE}"
    rm -f "${HOME}/.local/share/loopr/daemon.sock"
fi

###############################################################################
# Step 5: Start daemon from target directory
###############################################################################

DAEMON_LOG="${TARGET}/daemon.log"
log "Starting daemon from ${TARGET} (log: ${DAEMON_LOG})..."
(cd "${TARGET}" && "${LOOPR}" --config "${CONFIG}" daemon) > "${DAEMON_LOG}" 2>&1 &
DAEMON_PID=$!

SOCKET="${HOME}/.local/share/loopr/daemon.sock"
for i in $(seq 1 30); do
    if [[ -S "${SOCKET}" ]]; then
        ok "Daemon ready (PID ${DAEMON_PID})"
        break
    fi
    sleep 0.5
done

if [[ ! -S "${SOCKET}" ]]; then
    err "Daemon socket never appeared"
    exit 1
fi

###############################################################################
# Step 6: Run the E2E task
###############################################################################

GOAL="$(target_goal)"
PLAN="$(target_plan)"

log "Starting E2E run (timeout: ${TIMEOUT}s)..."
log "Goal: ${GOAL}"
echo ""

EXIT_CODE=0
(cd "${TARGET}" && "${LOOPR}" --config "${CONFIG}" run \
    --plan "${PLAN}" \
    --timeout "${TIMEOUT}" \
    "${GOAL}") || EXIT_CODE=$?

echo ""

###############################################################################
# Step 7: Collect results
###############################################################################

echo -e "${BOLD}${CYAN}=== E2E Results (${E2E_TARGET}) ===${NC}"

case ${EXIT_CODE} in
    0)  ok "Exit code: 0 (GoalComplete)" ;;
    1)  warn "Exit code: 1 (Timeout)" ;;
    2)  warn "Exit code: 2 (NeedHelp)" ;;
    *)  err "Exit code: ${EXIT_CODE} (unexpected)" ;;
esac

echo ""
log "TaskStore state:"
(cd "${TARGET}" && "${LOOPR}" --config "${CONFIG}" diagnose state 2>/dev/null) || warn "diagnose state failed"

echo ""
log "Agent sessions:"
(cd "${TARGET}" && "${LOOPR}" --config "${CONFIG}" agent list 2>/dev/null) || warn "agent list failed"

echo ""
log "Work items:"
(cd "${TARGET}" && "${LOOPR}" --config "${CONFIG}" work list 2>/dev/null) || warn "work list failed"

echo ""
log "Bundles:"
(cd "${TARGET}" && "${LOOPR}" --config "${CONFIG}" bundle list 2>/dev/null) || warn "bundle list failed"

echo ""
log "Git log (target repo):"
(cd "${TARGET}" && git log --oneline --all 2>/dev/null) || warn "git log failed"

echo ""
collect_results

echo ""
echo -e "${BOLD}${CYAN}=== Verification ===${NC}"
verify

if [[ ${EXIT_CODE} -ne 0 && -f "${DAEMON_LOG}" ]]; then
    echo ""
    log "Daemon log (last 50 lines):"
    /usr/bin/tail -50 "${DAEMON_LOG}"
fi

echo ""
echo -e "${BOLD}${CYAN}=== Summary ===${NC}"
echo -e "  Target:     ${E2E_TARGET}"
echo -e "  Directory:  ${TARGET}"
echo -e "  Timeout:    ${TIMEOUT}s"
echo -e "  Exit code:  ${EXIT_CODE}"
echo -e "  Daemon log: ${DAEMON_LOG}"
echo -e "  Session:    ~/.local/share/loopr/sessions/latest/"
echo -e "  Agent logs: ~/.local/share/loopr/logs/agents/"
echo -e "${CYAN}==================${NC}"

exit ${EXIT_CODE}
