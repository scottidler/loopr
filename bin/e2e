        ok "React todo target ready at ${RUN_DIR}"
        ;;

    *)
        err "Scaffold for target '${E2E_TARGET}' is not implemented in bin/e2e."
        err "Add a case for it above the default '*' branch."
        exit 1
        ;;
esac

###############################################################################
# Run-dir setup
###############################################################################

# Top-level Config is deny_unknown_fields + serde(default), so a partial
# config.yml carrying only an integrator: block is valid (every other section
# falls back to its Default -- a partial llm: block would NOT be, since
# LlmConfig lacks per-field deserializer defaults). Phase 12 made
# integrator.require-validation default true, so we MUST write
# validation-commands or the daemon refuses to start. Values are quoted: an
# unquoted `false` would parse as a YAML bool and fail Vec<String> deser.
mkdir -p "${RUN_DIR}/.loopr"
{
    echo "integrator:"
    echo "  validation-commands:"
    for _vc in "${VALIDATION_COMMANDS[@]}"; do
        printf '    - "%s"\n' "${_vc//\"/\\\"}"
    done
} > "${RUN_DIR}/.loopr/config.yml"
ok "Wrote .loopr/config.yml (validation-commands: ${VALIDATION_COMMANDS[*]})"

mkdir -p "${MONITOR_DIR}"
ok "Monitor dir: ${MONITOR_DIR}"

###############################################################################
# init + session + daemon
###############################################################################

log "Allocating session..."
"${LOOPR_BIN}" -C "${RUN_DIR}" sessions new 2>&1 | sed 's/^/  /'

# Daemon fork-mode parent times out at START_TIMEOUT_SECS=3; cold caches can
# push grandchild socket-bind past that. Retry once on failure.
SOCKET="${RUN_DIR}/.loopr/socket"
START_OK=false
for attempt in 1 2; do
    log "Starting daemon (forks, attempt ${attempt})..."
    if "${LOOPR_BIN}" -C "${RUN_DIR}" -l "${LOG_LEVEL}" daemon start 2>&1 | sed 's/^/  /'; then
        if [[ -S "${SOCKET}" ]]; then
            START_OK=true
            break
        fi
    fi
    sleep 1
    rm -f "${SOCKET}" "${RUN_DIR}/.loopr/daemon.pid" 2>/dev/null || true
done

if [[ "${START_OK}" == "false" ]]; then
    err "Daemon socket never appeared at ${SOCKET} after 2 attempts"
    exit 1
fi

DAEMON_PID="$(cat "${RUN_DIR}/.loopr/daemon.pid" 2>/dev/null || echo unknown)"
ok "Daemon ready (PID ${DAEMON_PID})"

# Resolve XDG-rooted log paths for this run. v5 writes events.log under
# ~/.local/share/loopr/sessions/<sid>/targets/<slug>/runs/<process-id>/,
# NOT under <target>/.loopr/runs/. The slug is the absolute target path
# with all '/' replaced by '-'. The session id is in active-session;
# the daemon's process-id is in daemon.process-id.
SESSION_ID="$(cat "${RUN_DIR}/.loopr/active-session" 2>/dev/null || echo "")"
PROCESS_ID="$(cat "${RUN_DIR}/.loopr/daemon.process-id" 2>/dev/null || echo "")"
TARGET_SLUG="$(echo "${RUN_DIR}" | tr '/' '-')"
XDG_TARGET_DIR="${HOME}/.local/share/loopr/sessions/${SESSION_ID}/targets/${TARGET_SLUG}"
EVENTS_LOG="${XDG_TARGET_DIR}/runs/${PROCESS_ID}/events.log"
FANOUT_LOG="${XDG_TARGET_DIR}/session-fanout.log"

if [[ -n "${SESSION_ID}" && -n "${PROCESS_ID}" ]]; then
    ok "Events log:  ${EVENTS_LOG}"
    ok "Fanout log:  ${FANOUT_LOG}"
else
    EVENTS_LOG=""
    FANOUT_LOG=""
    warn "session_id or process_id missing; log paths unresolved"
fi

###############################################################################
# Submit the Plan
###############################################################################

log "Submitting plan from ${PLAN_MD} ..."
GOAL="$(cat "${PLAN_MD}")"
"${LOOPR_BIN}" -C "${RUN_DIR}" plan create "${GOAL}" 2>&1 | sed 's/^/  /' || warn "plan submission returned non-zero"

###############################################################################
# Print key paths
###############################################################################

echo ""
echo -e "${BOLD}${CYAN}=== E2E paths ===${NC}"
echo -e "  Run dir:     ${RUN_DIR}"
echo -e "  Latest:      ${LATEST_LINK}"
echo -e "  Config:      <none — using v5 defaults>"
echo -e "  TaskStore:   ${RUN_DIR}/.loopr/taskstore/"
echo -e "  Records:     ${RUN_DIR}/.loopr/records/"
echo -e "  Events log:  ${EVENTS_LOG:-<unresolved>}"
echo -e "  Fanout log:  ${FANOUT_LOG:-<unresolved>}"
echo -e "  Worktrees:   ${RUN_DIR}/.loopr/worktrees/"
echo -e "${CYAN}=================${NC}"
echo ""

###############################################################################
# Background monitors
###############################################################################

# 1) Tail the human-readable session-fanout log (DEBUG-formatted). The
# structured JSON events.log carries the same content for retrospective
# analysis but is too noisy to live-tail.
if [[ -n "${FANOUT_LOG}" ]]; then
    log "Tailing session-fanout.log ..."
    (
        for _ in $(seq 1 20); do
            [[ -f "${FANOUT_LOG}" ]] && break
            sleep 0.5
        done
        if [[ -f "${FANOUT_LOG}" ]]; then
            /usr/bin/tail -f "${FANOUT_LOG}" | sed 's/^/[fanout] /'
        else
            warn "session-fanout.log never appeared at ${FANOUT_LOG}"
        fi
    ) &
    BG_TAIL_PID=$!
fi

# 2) Periodic taskstore + record snapshot every 30s
(
    TS_DIR="${RUN_DIR}/.loopr/taskstore"
    while true; do
        sleep 30
        echo ""
        echo -e "${BOLD}${CYAN}=== TaskStore snapshot ($(date +%H:%M:%S)) ===${NC}"
        if [[ -d "${TS_DIR}" ]]; then
            for jsonl in "${TS_DIR}"/*.jsonl; do
                [[ -f "${jsonl}" ]] || continue
                name="$(basename "${jsonl}" .jsonl)"
                count="$(wc -l < "${jsonl}")"
                if [[ "${count}" -gt 0 ]]; then
                    last="$("/usr/bin/tail" -1 "${jsonl}" | python3 -c '
import sys, json
try:
    r = json.loads(sys.stdin.read())
    parts = []
    for k in ("id","status","goal","title"):
        if k in r:
            v = str(r[k])
            if len(v) > 50:
                v = v[:47] + "..."
            parts.append(f"{k}={v}")
    print(" | ".join(parts))
except Exception as e:
    print(f"<parse error: {e}>")
' 2>/dev/null || echo "<parse failed>")"
                    echo -e "  ${BOLD}${name}${NC} (${count}): ${last}"
                fi
            done
        fi
        echo -e "${CYAN}===========================================${NC}"

        # Records-derived summaries (per-record markdown digests)
        REC_DIR="${RUN_DIR}/.loopr/records"
        if [[ -d "${REC_DIR}" ]]; then
            local_count="$(find "${REC_DIR}" -name "summary.md" 2>/dev/null | wc -l)"
            if [[ "${local_count}" -gt 0 ]]; then
                echo -e "  ${DIM}records: ${local_count} summary.md file(s) under ${REC_DIR}${NC}"
            fi
        fi
    done
) &
BG_MONITOR_PID=$!

###############################################################################
# Wait for completion or timeout
###############################################################################

log "Daemon running. Timeout: ${TIMEOUT}s. Watching for a Tick on main..."
echo ""

SECONDS=0
TICK_LANDED=false
while (( SECONDS < TIMEOUT )); do
    if ! kill -0 "${DAEMON_PID}" 2>/dev/null; then
        warn "Daemon exited early after ${SECONDS}s"
        break
    fi
    if [[ -f "${RUN_DIR}/.loopr/taskstore/ticks.jsonl" ]]; then
        if [[ "$(wc -l < "${RUN_DIR}/.loopr/taskstore/ticks.jsonl")" -gt 0 ]]; then
            TICK_LANDED=true
            ok "Tick landed at ${SECONDS}s — goal complete"
            break
        fi
    fi
    sleep 5
done

if [[ "${TICK_LANDED}" == "false" && ${SECONDS} -ge ${TIMEOUT} ]]; then
    warn "Timeout reached (${TIMEOUT}s). No Tick landed."
fi

# Stop background monitors before result collection so output is clean
kill "${BG_TAIL_PID}" "${BG_MONITOR_PID}" 2>/dev/null || true
wait 2>/dev/null || true
echo ""

###############################################################################
# Collect results
###############################################################################

echo -e "${BOLD}${CYAN}=== Plans ===${NC}"
"${LOOPR_BIN}" -C "${RUN_DIR}" plans 2>&1 | sed 's/^/  /' || warn "plans list failed"
echo ""
echo -e "${BOLD}${CYAN}=== Works ===${NC}"
"${LOOPR_BIN}" -C "${RUN_DIR}" works 2>&1 | sed 's/^/  /' || warn "works list failed"
echo ""
echo -e "${BOLD}${CYAN}=== Bundles ===${NC}"
"${LOOPR_BIN}" -C "${RUN_DIR}" bundles 2>&1 | sed 's/^/  /' || warn "bundles list failed"
echo ""
echo -e "${BOLD}${CYAN}=== Ticks ===${NC}"
"${LOOPR_BIN}" -C "${RUN_DIR}" ticks 2>&1 | sed 's/^/  /' || warn "ticks list failed"
echo ""
echo -e "${BOLD}${CYAN}=== Sessions ===${NC}"
"${LOOPR_BIN}" -C "${RUN_DIR}" sessions list 2>&1 | sed 's/^/  /' || warn "sessions list failed"
echo ""
echo -e "${BOLD}${CYAN}=== Git log ===${NC}"
git -C "${RUN_DIR}" log --oneline --all 2>&1 | sed 's/^/  /' || warn "git log failed"
echo ""

###############################################################################
# Verify the goal
###############################################################################

EXIT_CODE=0
echo -e "${BOLD}${CYAN}=== Verification ===${NC}"
case "${E2E_TARGET}" in
    rust-version)
        if (cd "${RUN_DIR}" && cargo build --quiet 2>/dev/null); then
            VERSION_OUTPUT="$(cd "${RUN_DIR}" && cargo run --quiet -- --version 2>&1 || true)"
            if [[ -n "${VERSION_OUTPUT}" ]]; then
                ok "--version output: ${VERSION_OUTPUT}"
                if [[ "${VERSION_OUTPUT}" == *"0.1.0"* ]]; then
                    ok "Version string contains 0.1.0"
                else
                    warn "Version string does not contain 0.1.0"
                    EXIT_CODE=3
                fi
            else
                err "--version produced no output"
                EXIT_CODE=3
            fi
        else
            err "cargo build failed on the target"
            EXIT_CODE=3
        fi

        echo ""
        if (cd "${RUN_DIR}" && cargo test 2>&1 | /usr/bin/tail -10); then
            ok "cargo test completed"
        else
            warn "cargo test had failures"
            EXIT_CODE=3
        fi
        ;;

    python-todo)
        for f in todo.py cli.py test_todo.py; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && uv run python cli.py add "Test item from e2e" 2>&1); then
            ok "cli.py add succeeded"
            if (cd "${RUN_DIR}" && uv run python cli.py list 2>&1 | grep -q "Test item"); then
                ok "cli.py list shows the added item"
            else
                warn "cli.py list did not show the added item"; EXIT_CODE=3
            fi
        else
            warn "cli.py add failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && uv run pytest test_todo.py -v 2>&1 | /usr/bin/tail -15); then
            ok "pytest completed"
        else
            warn "pytest had failures"; EXIT_CODE=3
        fi
        ;;

    python-api)
        for f in database.py main.py test_api.py; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && docker compose build 2>&1 | /usr/bin/tail -5); then
            ok "docker compose build succeeded"
        else
            warn "docker compose build failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && docker compose run --rm test 2>&1 | /usr/bin/tail -20); then
            ok "docker compose run --rm test passed"
        else
            warn "tests had failures"; EXIT_CODE=3
        fi
        echo ""
        (cd "${RUN_DIR}" && docker compose up -d api 2>&1 | /usr/bin/tail -3) || true
        sleep 3
        if curl -sf http://localhost:8081/health | grep -q "ok"; then
            ok "GET /health returned ok"
            CREATED=$(curl -sf -X POST http://localhost:8081/bookmarks \
                -H "Content-Type: application/json" \
                -d '{"title":"E2E Test","url":"https://example.com","tags":"e2e"}' 2>/dev/null || true)
            if echo "${CREATED}" | grep -q "E2E Test"; then
                ok "POST /bookmarks created a bookmark"
                if curl -sf http://localhost:8081/bookmarks | grep -q "E2E Test"; then
                    ok "GET /bookmarks returned the created bookmark"
                else
                    warn "GET /bookmarks did not return expected bookmark"; EXIT_CODE=3
                fi
            else
                warn "POST /bookmarks did not return expected data"; EXIT_CODE=3
            fi
        else
            warn "GET /health failed (API may not have started)"; EXIT_CODE=3
        fi
        (cd "${RUN_DIR}" && docker compose down 2>/dev/null || true)
        ;;

    python-scraper)
        for f in scraper.py database.py report.py main.py test_scraper.py; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && docker compose build 2>&1 | /usr/bin/tail -5); then
            ok "docker compose build succeeded"
        else
            warn "docker compose build failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && docker compose run --rm test 2>&1 | /usr/bin/tail -20); then
            ok "docker compose run --rm test passed"
        else
            warn "tests had failures"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && docker compose run --rm \
                -e DATABASE_PATH=/tmp/verify_links.db \
                -e REPORT_PATH=/tmp/verify_report.md \
                harvester 2>&1 | /usr/bin/tail -5); then
            ok "harvester ran without error"
        else
            warn "harvester run failed"; EXIT_CODE=3
        fi
        if [[ -f "${RUN_DIR}/report.md" ]]; then
            ok "report.md was generated"
            grep -q "Total links" "${RUN_DIR}/report.md" && ok "report contains 'Total links'" || { warn "report missing 'Total links'"; EXIT_CODE=3; }
            grep -q "Top Domains" "${RUN_DIR}/report.md" && ok "report contains 'Top Domains'" || { warn "report missing 'Top Domains'"; EXIT_CODE=3; }
        else
            warn "report.md was not generated"; EXIT_CODE=3
        fi
        ;;

    lua-todo)
        for f in todo.lua cli.lua test_todo.lua; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && lua cli.lua add "Test item from e2e" 2>&1); then
            ok "cli.lua add succeeded"
            if (cd "${RUN_DIR}" && lua cli.lua list 2>&1 | grep -q "Test item"); then
                ok "cli.lua list shows the added item"
            else
                warn "cli.lua list did not show the added item"; EXIT_CODE=3
            fi
        else
            warn "cli.lua add failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && lua test_todo.lua 2>&1 | /usr/bin/tail -15); then
            ok "tests completed"
        else
            warn "tests had failures"; EXIT_CODE=3
        fi
        ;;

    rust-cli)
        for f in src/main.rs src/db.rs tests/cli.rs; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && cargo build --quiet 2>&1); then
            ok "cargo build succeeded"
        else
            warn "cargo build failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && cargo test 2>&1 | /usr/bin/tail -15); then
            ok "cargo test passed"
        else
            warn "cargo test had failures"; EXIT_CODE=3
        fi
        echo ""
        BINARY="${RUN_DIR}/target/debug/notes"
        DB="${RUN_DIR}/verify_test.db"
        if [[ -x "${BINARY}" ]]; then
            ADD_OUT=$("${BINARY}" --db "${DB}" add "Verify Test" 2>&1 || true)
            if echo "${ADD_OUT}" | grep -q "Verify Test"; then
                ok "notes add works: ${ADD_OUT}"
            else
                warn "notes add did not produce expected output: ${ADD_OUT}"; EXIT_CODE=3
            fi
            LIST_OUT=$("${BINARY}" --db "${DB}" list 2>&1 || true)
            if echo "${LIST_OUT}" | grep -q "Verify Test"; then
                ok "notes list shows the added note"
            else
                warn "notes list did not show expected note: ${LIST_OUT}"; EXIT_CODE=3
            fi
            SEARCH_OUT=$("${BINARY}" --db "${DB}" search "Verify" 2>&1 || true)
            if echo "${SEARCH_OUT}" | grep -q "Verify Test"; then
                ok "notes search finds matching note"
            else
                warn "notes search did not find expected note: ${SEARCH_OUT}"; EXIT_CODE=3
            fi
            rm -f "${DB}"
        else
            warn "Binary not found at ${BINARY}"; EXIT_CODE=3
        fi
        ;;

    node-api)
        for f in db.js app.js test/notes.test.js; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && docker compose build 2>&1 | /usr/bin/tail -5); then
            ok "docker compose build succeeded"
        else
            warn "docker compose build failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && docker compose run --rm test 2>&1 | /usr/bin/tail -20); then
            ok "docker compose run --rm test passed"
        else
            warn "tests had failures"; EXIT_CODE=3
        fi
        echo ""
        (cd "${RUN_DIR}" && docker compose up -d api 2>&1 | /usr/bin/tail -3) || true
        sleep 3
        if curl -sf http://localhost:8082/health | grep -q "ok"; then
            ok "GET /health returned ok"
            CREATED=$(curl -sf -X POST http://localhost:8082/notes \
                -H "Content-Type: application/json" \
                -d '{"title":"E2E Test","content":"hello","tags":"e2e"}' 2>/dev/null || true)
            if echo "${CREATED}" | grep -q "E2E Test"; then
                ok "POST /notes created a note"
                if curl -sf http://localhost:8082/notes | grep -q "E2E Test"; then
                    ok "GET /notes returned the created note"
                else
                    warn "GET /notes did not return expected note"; EXIT_CODE=3
                fi
            else
                warn "POST /notes did not return expected data"; EXIT_CODE=3
            fi
        else
            warn "GET /health failed (API may not have started)"; EXIT_CODE=3
        fi
        (cd "${RUN_DIR}" && docker compose down 2>/dev/null || true)
        ;;

    react-todo)
        for f in src/App.tsx src/main.tsx Dockerfile; do
            if [[ -f "${RUN_DIR}/${f}" ]]; then ok "${f} exists"
            else warn "${f} missing"; EXIT_CODE=3; fi
        done
        echo ""
        if (cd "${RUN_DIR}" && npm run build 2>&1 | /usr/bin/tail -10); then
            ok "npm run build succeeded"
        else
            warn "npm run build failed"; EXIT_CODE=3
        fi
        echo ""
        if (cd "${RUN_DIR}" && docker build -t loopr-e2e-react-todo . 2>&1 | /usr/bin/tail -10); then
            ok "docker build succeeded"
        else
            warn "docker build failed"; EXIT_CODE=3
        fi
        echo ""
        CONTAINER_ID=$(docker run -d -p 14173:80 loopr-e2e-react-todo 2>/dev/null || true)
        if [[ -n "${CONTAINER_ID}" ]]; then
            sleep 2
            if curl -s http://localhost:14173 | grep -q "root"; then
                ok "curl returned HTML with root div"
            else
                warn "curl did not find root div in response"; EXIT_CODE=3
            fi
            docker stop "${CONTAINER_ID}" >/dev/null 2>&1 || true
            docker rm "${CONTAINER_ID}" >/dev/null 2>&1 || true
        else
            warn "docker run failed"; EXIT_CODE=3
        fi
        ;;
esac

if [[ "${TICK_LANDED}" == "false" ]]; then
    EXIT_CODE=$(( EXIT_CODE == 0 ? 1 : EXIT_CODE ))
fi
echo ""

###############################################################################
# Snapshot results
###############################################################################

RESULTS_FILE="${MONITOR_DIR}/results.md"
{
    echo "# Loopr v5 E2E Results"
    echo ""
    echo "- **Target:**     ${E2E_TARGET}"
    echo "- **Timestamp:**  ${TIMESTAMP}"
    echo "- **Run dir:**    ${RUN_DIR}"
    echo "- **Duration:**   ${SECONDS}s"
    echo "- **Tick landed:** ${TICK_LANDED}"
    echo "- **Exit code:**  ${EXIT_CODE}"
    echo ""

    echo "## TaskStore"
    echo ""
    TS_DIR="${RUN_DIR}/.loopr/taskstore"
    if [[ -d "${TS_DIR}" ]]; then
        for jsonl in "${TS_DIR}"/*.jsonl; do
            [[ -f "${jsonl}" ]] || continue
            name="$(basename "${jsonl}" .jsonl)"
            count="$(wc -l < "${jsonl}")"
            echo "### ${name} (${count} records)"
            echo ""
            if [[ "${count}" -gt 0 ]]; then
                echo '```json'
                cat "${jsonl}"
                echo '```'
            fi
            echo ""
        done
    fi

    echo "## Project tree"
    echo ""
    echo '```'
    (cd "${RUN_DIR}" && find . -not -path './.git/*' -not -path './.loopr/*' -not -path './target/*' -not -path './.monitor/*' -type f | sort)
    echo '```'
    echo ""

    echo "## Git log"
    echo ""
    echo '```'
    git -C "${RUN_DIR}" log --oneline --all 2>/dev/null || echo "(no commits)"
    echo '```'
    echo ""

    if [[ -n "${FANOUT_LOG}" && -f "${FANOUT_LOG}" ]]; then
        echo "## session-fanout.log (last 200 lines)"
        echo ""
        echo '```'
        /usr/bin/tail -200 "${FANOUT_LOG}"
        echo '```'
    fi

    if [[ -n "${EVENTS_LOG}" && -f "${EVENTS_LOG}" ]]; then
        echo ""
        echo "## events.log path (JSON, full detail)"
        echo ""
        echo "${EVENTS_LOG}"
    fi
} > "${RESULTS_FILE}"

ok "Results snapshot: ${RESULTS_FILE}"

###############################################################################
# Optional Claude evaluation
###############################################################################

if [[ "${SKIP_EVAL}" == "false" ]] && command -v claude >/dev/null 2>&1; then
    log "Running Claude evaluation ..."
    EVAL_PROMPT="You are evaluating an end-to-end run of the loopr-v5 orchestrator.
The goal was: see ${PLAN_MD}.
The run dir is ${RUN_DIR}.

Examine ${RESULTS_FILE} and the run dir. Report:
1. Did the daemon decompose, implement, review, and integrate?
2. Did a Tick land on main?
3. Does the target's '--version' output match expectations?
4. Look at events.log for these spans (added in 2026-04-24 instrumentation sweep):
   - lifeguard.check_action: action_hash / action_count / max_repeat — did the lifeguard fire?
   - decomposer.decompose: outcome (ok/cycle_detected/llm_failed/...) — did decomposition succeed?
   - integrator.integrate: phase (preflight/git_sequence/commit) — how far did integration get?
   - tool.<name>: which tools ran in which lanes?
5. Verdict: SUCCESS, PARTIAL, or FAILURE with explanation.

Just read files and report. Do not write code or modify anything."

    claude -p "${EVAL_PROMPT}" \
        --allowedTools "Read,Glob,Grep,Bash(read-only commands)" \
        2>&1 | tee "${MONITOR_DIR}/evaluation.md"
    ok "Evaluation: ${MONITOR_DIR}/evaluation.md"
fi

###############################################################################
# Summary
###############################################################################

echo ""
echo -e "${BOLD}${CYAN}=== Summary ===${NC}"
echo -e "  Target:     ${E2E_TARGET}"
echo -e "  Run dir:    ${RUN_DIR}"
echo -e "  Latest:     ${LATEST_LINK}"
echo -e "  Duration:   ${SECONDS}s"
echo -e "  Tick:       ${TICK_LANDED}"
echo -e "  Exit code:  ${EXIT_CODE} (0=ok, 1=timeout, 3=verify-failed)"
echo -e "  Events log: ${EVENTS_LOG:-<unresolved>}"
echo -e "  Results:    ${RESULTS_FILE}"
echo -e "${CYAN}===============${NC}"

exit "${EXIT_CODE}"
