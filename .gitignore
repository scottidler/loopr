# Generated by Cargo
# will have compiled files and executables
/target/

# Loopr is an executable — Cargo.lock IS committed
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# Added by cargo
/target

*.png
*.svg

# Example generated files - ignore common output files from Otto examples
examples/*/some-file
