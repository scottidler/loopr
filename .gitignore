examples/*/*.exe
examples/*/myapp
examples/*/app
examples/*/program
examples/*/*.log
examples/*/line_count.txt
examples/*/summary_output.txt
examples/*/test_results.log
examples/*/deployment.log
examples/*/build/
examples/*/dist/
examples/*/target/

# tarpaulin coverage reports
lcov.info
tarpaulin-report.html
examples/_test_broken/

# Loopr runtime data
.taskstore/
.worktrees/
.env

